[0m17:13:25.430958 [debug] [Thread-3 (]: On model.logistics_intelligence.mart_daily_kpi: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "logistics_intelligence", "target_name": "dev", "node_id": "model.logistics_intelligence.mart_daily_kpi"} */

  create view "logistics_intelligence"."dbt_dev_analytics"."mart_daily_kpi__dbt_tmp"
    
    
  as (
    with orders as (
    select *
    from "logistics_intelligence"."dbt_dev_analytics"."fct_orders"
)
select
    order_created_at::date as order_date,
    count(*) as total_orders,
    sum(delivered_flag) as delivered_orders,
    sum(returned_flag) as returned_orders,
    round(
        100.0 * sum(delivered_flag)
        / nullif(count(*) filter (where final_status <> 'Cancelled'), 0),
        2
    ) as delivery_success_rate_pct,
    round(
        100.0 * sum(sla_compliant_flag)
        / nullif(count(sla_compliant_flag), 0),
        2
    ) as sla_compliance_pct,
    round(
        avg(delivery_tat_hours) filter (where delivered_flag = 1),
        2
    ) as avg_delivery_tat_hours
from orders
group by order_created_at::date
  );
